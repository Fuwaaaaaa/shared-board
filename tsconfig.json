{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    // qrcode-generator の型定義が export = 形式のため
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // node は e2e と playwright.config.ts のため（process / Buffer）。
    // src で process を使えてしまわないよう、そちらは ESLint 側で止めている
    "types": ["vite/client", "node"]
  },
  // e2e と playwright.config.ts も入れる。型を要求する ESLint ルールを
  // 入れていないので、ここから外すと e2e の型の間違いは実際に走らせるまで出ない
  "include": [
    "src",
    "e2e",
    "vite.config.ts",
    "vitest.workspace.ts",
    "playwright.config.ts"
  ]
}
